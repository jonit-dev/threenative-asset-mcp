{
  "name": "@threenative/fab-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for searching public Fab assets and downloading directly available free files.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "bin": {
    "fab-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "fab",
    "mcp",
    "model-context-protocol",
    "threenative"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonit-dev/fab-mcp.git"
  },
  "homepage": "https://github.com/jonit-dev/fab-mcp#readme",
  "bugs": {
    "url": "https://github.com/jonit-dev/fab-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "browser:install": "playwright install chromium",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "probe:fab": "tsx scripts/probe-fab.ts",
    "test": "vitest run",
    "test:live": "tsx scripts/probe-fab.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npx --yes @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "playwright": "1.62.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
